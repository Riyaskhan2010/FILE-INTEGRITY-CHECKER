# File Integrity Checker — Environment Variables
# Copy this file to .env and set real values before deploying.
# Never commit .env to version control.

# Flask secret key — change to a long random string in production
SECRET_KEY=change-me-to-a-long-random-secret-string

# JWT signing secret — change to a different long random string in production
JWT_SECRET_KEY=change-me-to-a-different-long-jwt-secret

# Optional: Flask environment (development | production)
FLASK_ENV=development
